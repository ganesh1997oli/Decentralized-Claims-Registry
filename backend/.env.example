# Copy to .env.local and load it with the integration environment files.

SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Use a fresh Sepolia-only wallet with test ETH and assessor permission.
SEPOLIA_PRIVATE_KEY=""

MODULE_ID="ClaimsRegistryModule#ClaimsRegistry"
RECEIPT_TIMEOUT="180"

# inline_demo preserves the original synchronous scorer.
# async_xgboost anchors first and lets Kafka run the XGBoost assessment.
CLAIM_SCORING_MODE="async_xgboost"
FRAUD_MODEL_PATH="model/artifacts/synthetic-logistic-v1.json"

FRONTEND_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
