# Local application configuration
#
# Copy this file once:
#   cp .env.example .env.local
#
# Add your own values to .env.local, then load it from the repository root:
#   set -a
#   source .env.local
#   set +a
#
# The local file is ignored by Git. Keep real keys and tokens out of this
# example, screenshots, terminal recordings, and browser-facing VITE_ values.

# Ethereum Sepolia
SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"

# Use three separate, fresh Sepolia-only wallets. Keep the deployer key on the
# deployment workstation; only the two least-privilege service keys belong in
# the application environment.
SEPOLIA_DEPLOYER_PRIVATE_KEY=""
SEPOLIA_SUBMITTER_PRIVATE_KEY=""
SEPOLIA_ASSESSOR_PRIVATE_KEY=""
# This directory contains the reviewed hardened ABI and deployed address.
CLAIMS_DEPLOYMENT_ID="sepolia-security-audit-v1"
RECEIPT_TIMEOUT="180"

# Claim submission
# Claims are anchored first, then Kafka runs duplicate detection and XGBoost.
FRONTEND_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# The server stores only SHA-256 digests of insurer API keys. These entries match
# the fictional credentials documented in apps/backend/README.md; generate new
# random credentials before hosting the project. The final entry is dedicated
# to local API-based performance testing and is not a normal insurer account.
INSURER_CREDENTIALS_JSON='[{"credentialId":"northstar-local-v1","insurerId":"northstar-mutual","apiKeySha256":"05b098cc02358da9323eac33b586a9570a5356c494b63cae6c53663b2b5c49fc","dailyQuota":25},{"credentialId":"harbour-local-v1","insurerId":"harbour-shield","apiKeySha256":"0f5c7ff7458e732ba2ebbf31df08f4e1819f3eb123e51be45d9e27749c9abbab","dailyQuota":25},{"credentialId":"cedar-local-v1","insurerId":"cedar-insurance","apiKeySha256":"5b83b931fb3549efd0fca9eaf12ee008ba24cf79fbf3d899446bffd060986787","dailyQuota":25},{"credentialId":"performance-test-v1","insurerId":"performance-test-insurer","apiKeySha256":"a046fd6eea194db30bba3f5deb7a6d9fc5b7b7f62ac6009f539052509bae3036","dailyQuota":25,"rateLimitExempt":true}]'
INSURER_RATE_LIMIT_PER_MINUTE="5"
IP_RATE_LIMIT_PER_MINUTE="20"
MAX_CLAIM_BODY_BYTES="16384"

# Authenticated, read-only indexer operations dashboard. The local raw key is:
#   local-indexer-operations-key-change-before-hosting
# Store only its SHA-256 digest in the API environment. Generate a new random
# credential with apps/backend/scripts/generate_operations_credential.py before
# hosting; never use a VITE_ variable for this secret.
INDEXER_OPERATIONS_API_KEY_SHA256="48dc7cd0a10e3a2d486a1c14d84fee3413f53abbc06418186b75ed4ec5173077"
INDEXER_STALE_AFTER_SECONDS="120"

# Authorised local performance testing (disabled by default)
# The dedicated local raw key is:
#   local-performance-test-insurer-api-key-change-me
# The credential above remains limited unless this master switch is also true.
# Enable it only for a controlled test, then restore false and restart the API.
# Keep this master switch false during normal use. A performance-test credential
# also needs rateLimitExempt=true before any limit can be bypassed.
ALLOW_RATE_LIMIT_BYPASS="false"

# Shared only by the trusted API and scoring worker. It attests that an IPFS
# claim passed through the authenticated gateway before the worker scores it.
CLAIM_AUTHORIZATION_KEY="local-research-claim-authorization-key-change-before-hosting"

# Private HMAC key for cross-insurer incident fingerprints. This local value is
# suitable only for fictional research data. Replace it through a secret manager
# before any hosted deployment; changing it starts a new fingerprint namespace.
DUPLICATE_FINGERPRINT_KEY="local-research-key-change-me-before-hosting"

# IPFS through Pinata
# Only server-side Python processes use this token. Never rename it with VITE_.
PINATA_JWT=""
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# Local Kafka
# These defaults match packages/integrations/kafka/compose.yml.
KAFKA_ENABLED="true"
KAFKA_BOOTSTRAP_SERVERS="127.0.0.1:9092"
KAFKA_CLAIM_SUBMITTED_TOPIC="claims.submitted.sepolia-audit-v1"
KAFKA_CLIENT_ID="claims-registry-listener"
KAFKA_CONSUMER_GROUP_ID="claims-registry-scorer-sepolia-audit-v1"
KAFKA_DELIVERY_TIMEOUT_MS="30000"
KAFKA_CONSUMER_POLL_SECONDS="1"
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"

# Leave these empty for the local PLAINTEXT broker. A hosted Kafka service may
# require SASL_SSL credentials supplied by its secret manager.
KAFKA_SASL_MECHANISM=""
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# Local PostgreSQL from packages/integrations/kafka/compose.yml
DATABASE_URL="postgresql://claims:claims-local@127.0.0.1:5432/claims_registry"

# Reviewed artifact created by: python -m packages.model.train_xgboost --download
XGBOOST_MODEL_DIR="packages/model/artifacts/xgboost-african-motor-v1"

# This may stay empty because metadata.json contains the generated checksum.
XGBOOST_MODEL_SHA256=""

# Blockchain listener
POLL_INTERVAL="5"
CONFIRMATION_BLOCKS="12"
# A conservative public-RPC default. During a controlled stale-checkpoint
# catch-up, 250 or 500 reduces RPC round trips, but larger queries may time out
# or trigger provider rate limits. Tune against the selected RPC; do not assume
# that a larger value is universally safer or suitable for production.
MAX_BLOCK_RANGE="250"
LISTENER_STATE_DIR="apps/listener/.state"

# The checked-in hardened ClaimsRegistry was deployed in this block. A new
# index refuses to guess because starting at the current head would silently
# omit historical claims. Change this together with CLAIMS_DEPLOYMENT_ID.
LISTENER_START_BLOCK="11377814"

# Browser-safe settings
# Every VITE_ value is bundled into frontend code and is visible to users.
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"
