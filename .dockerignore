# Keep Docker's build context small and, more importantly, keep local secrets
# and machine-specific state out of image layers.
.git
.github
.env*
!.env.example
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.coverage
**/coverage-html
apps/frontend/dist
apps/contracts/cache
apps/contracts/artifacts
packages/model/artifacts
packages/model/data
packages/model/notebooks
infrastructure/gcp/evidence
*.docx
