__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage-html/

# Listener and scoring dead-letter files are runtime audit artifacts. They may
# contain public transaction metadata and belong in persistent operations
# storage, not source control.
**/.state/

# Keep local credentials and machine-specific settings out of Git.
.env
.env.*
!.env.example
!infrastructure/gcp/.env.gcp.example
infrastructure/gcp/.env.gcp-secrets/

# google-github-actions/auth creates a short-lived credentials file for gcloud.
# The action removes it after each job, and this rule prevents an interrupted
# local/action run from ever turning that file into source code.
gha-creds-*.json

# Terraform state can contain infrastructure details and is specific to one
# Google Cloud project. Keep only the human-readable example variables in Git.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Evidence bundles contain run-specific host names and transaction identifiers.
# Review them before deliberately copying selected results into the dissertation.
infrastructure/gcp/evidence/

# macOS Finder metadata is local machine clutter, not project source.
.DS_Store
**/.DS_Store

# Microsoft Word creates this lock file while a document is open.
~$*.docx
