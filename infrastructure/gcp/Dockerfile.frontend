FROM node:24-alpine AS build

WORKDIR /frontend

# Installing from the lock file produces the same frontend dependencies on the
# VM and in CI. Copying it separately also improves Docker's build cache.
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

COPY apps/frontend/ ./

# The browser calls the same public host under /api. Caddy privately forwards
# those requests to FastAPI, so port 8000 never needs to face the internet.
ARG VITE_API_BASE_URL=/api
ARG VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_IPFS_GATEWAY=${VITE_IPFS_GATEWAY}

RUN npm run build

FROM caddy:2.11.4-alpine

COPY infrastructure/gcp/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /frontend/dist /srv

RUN PUBLIC_HOST=example.invalid caddy validate --config /etc/caddy/Caddyfile

EXPOSE 80 443

# The health check uses Caddy's local HTTP listener and does not contact
# FastAPI, Sepolia, IPFS, DNS, or the certificate authority.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1/healthz || exit 1
