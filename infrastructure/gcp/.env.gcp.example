# Google Cloud single-VM configuration
#
# Copy this file to infrastructure/gcp/.env.gcp and replace each CHANGE_ME value.
# The copied file is ignored by Git. It is read by Docker Compose on the VM and
# must never be attached to the dissertation or pasted into a screenshot.

COMPOSE_PROJECT_NAME="decentralized-claims-cloud"

# Public browser address. Use the VM's external IP for the dissertation demo,
# for example http://34.123.45.67. HTTPS and a domain are deliberately left as a
# documented extension because this short-lived research VM is deleted later.
FRONTEND_ORIGINS="http://CHANGE_ME_VM_EXTERNAL_IP"
HTTP_PORT="80"

# Replace each digest with SHA-256(random API key). Give the raw key only to the
# matching fictional insurer operator; never place raw API keys on the server.
INSURER_CREDENTIALS_JSON='[{"credentialId":"northstar-cloud-v1","insurerId":"northstar-mutual","apiKeySha256":"CHANGE_ME_64_HEX_SHA256","dailyQuota":25},{"credentialId":"harbour-cloud-v1","insurerId":"harbour-shield","apiKeySha256":"CHANGE_ME_64_HEX_SHA256","dailyQuota":25},{"credentialId":"cedar-cloud-v1","insurerId":"cedar-insurance","apiKeySha256":"CHANGE_ME_64_HEX_SHA256","dailyQuota":25}]'
INSURER_RATE_LIMIT_PER_MINUTE="5"
IP_RATE_LIMIT_PER_MINUTE="20"
# Enable only for a controlled performance-test deployment that contains a
# dedicated credential with rateLimitExempt=true.
ALLOW_RATE_LIMIT_BYPASS="false"
MAX_CLAIM_BODY_BYTES="16384"
CLAIM_AUTHORIZATION_KEY="CHANGE_ME_RANDOM_CLAIM_AUTHORIZATION_KEY"

# Generate this digest with:
# python apps/backend/scripts/generate_operations_credential.py
# Give the raw key to trusted operators and store only the printed digest here.
INDEXER_OPERATIONS_API_KEY_SHA256="CHANGE_ME_64_HEX_SHA256"
INDEXER_STALE_AFTER_SECONDS="120"

# PostgreSQL stays inside Docker. Use a URL-safe hexadecimal password so it can
# be embedded in DATABASE_URL without percent-encoding surprises.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD="CHANGE_ME_RANDOM_HEX_PASSWORD"

# The backend submits test claims and the scoring worker writes assessments.
# Give them separate Sepolia-only wallets and only the contract role each needs.
# The deployment/admin key must not be copied onto the VM.
SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"
SEPOLIA_SUBMITTER_PRIVATE_KEY="CHANGE_ME_SUBMITTER_PRIVATE_KEY"
SEPOLIA_ASSESSOR_PRIVATE_KEY="CHANGE_ME_ASSESSOR_PRIVATE_KEY"
CLAIMS_DEPLOYMENT_ID="sepolia-security-audit-v1"
RECEIPT_TIMEOUT="180"

# Pinata is used only by server-side containers. Never expose this token through
# a VITE_ variable because all VITE_ values are visible in the browser bundle.
PINATA_JWT="CHANGE_ME_PINATA_JWT"
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# This secret creates private, repeatable incident fingerprints for duplicate
# detection. Keep the same value for all runs that should share a namespace.
# Generate one with: openssl rand -hex 32
DUPLICATE_FINGERPRINT_KEY="CHANGE_ME_RANDOM_HEX_HMAC_KEY"

# Kafka is private to this VM's Docker network. PLAINTEXT here does not cross the
# public internet, but this single broker is still a research deployment rather
# than a production cluster.
KAFKA_ENABLED="true"
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_CLAIM_SUBMITTED_TOPIC="claims.submitted.v1"
KAFKA_CLIENT_ID="claims-registry-cloud"
KAFKA_CONSUMER_GROUP_ID="claims-registry-scorer-v1"
KAFKA_DELIVERY_TIMEOUT_MS="30000"
KAFKA_CONSUMER_POLL_SECONDS="1"
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"
KAFKA_SASL_MECHANISM=""
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# The container sees the approved model at /opt/claims-model. The host path is
# resolved relative to infrastructure/gcp/compose.yml. Train it before deployment.
XGBOOST_MODEL_HOST_DIR="../../packages/model/artifacts/xgboost-african-motor-v1"
XGBOOST_MODEL_DIR="/opt/claims-model"
XGBOOST_MODEL_SHA256=""

# Only dead-letter evidence lives in this named volume. Indexed claims and the
# listener checkpoint live in PostgreSQL and survive container replacement.
LISTENER_STATE_DIR="/var/lib/claims-listener"
POLL_INTERVAL="5"
CONFIRMATION_BLOCKS="12"
# Keep the conservative default until the selected managed RPC has been tested.
# Values such as 250 or 500 reduce catch-up round trips but create heavier log
# queries and can trigger provider timeout, result-size, or rate-limit policies.
MAX_BLOCK_RANGE="50"
# Deployment block for sepolia-security-audit-v1. Change it when selecting a
# replacement deployment so a fresh database can rebuild the complete index.
LISTENER_START_BLOCK="11377814"
