# Google Cloud single-VM configuration
#
# Copy this file to infrastructure/gcp/.env.gcp and replace each CHANGE_ME value.
# The copied file and .env.gcp-secrets directory are ignored by Git. Keep both
# owner-only and never attach them to the dissertation or paste them into logs.

COMPOSE_PROJECT_NAME="decentralized-claims-cloud"

# Public HTTPS address. Terraform outputs a ready-to-use sslip.io hostname for
# its reserved IP. You may use your own DNS name after pointing it at that IP.
PUBLIC_HOST="CHANGE_ME_PUBLIC_HOST"
FRONTEND_ORIGINS="https://CHANGE_ME_PUBLIC_HOST"
HTTP_PORT="80"
HTTPS_PORT="443"

# Wallet-backed claimant sessions. All three keys must be independent and at
# least 32 bytes. Generate each with: openssl rand -hex 32
CLAIMANT_AUTH_DOMAIN="CHANGE_ME_PUBLIC_HOST"
CLAIMANT_AUTH_URI="https://CHANGE_ME_PUBLIC_HOST"
CLAIMANT_SESSION_SIGNING_KEY="CHANGE_ME_RANDOM_SESSION_SIGNING_KEY"
CLAIMANT_SUBJECT_KEY="CHANGE_ME_RANDOM_CLAIMANT_SUBJECT_KEY"
CLAIMANT_AUTH_FINGERPRINT_KEY="CHANGE_ME_RANDOM_AUTH_FINGERPRINT_KEY"
CLAIMANT_CHALLENGE_TTL_SECONDS="300"
CLAIMANT_SESSION_TTL_SECONDS="900"
CLAIMANT_AUTH_CLIENT_RATE_PER_MINUTE="20"
CLAIMANT_AUTH_WALLET_RATE_PER_MINUTE="5"
CLAIMANT_RATE_LIMIT_PER_MINUTE="5"
IP_RATE_LIMIT_PER_MINUTE="20"
ALLOW_RATE_LIMIT_BYPASS="false"
MAX_CLAIM_BODY_BYTES="16384"

# Controlled fictional-policy adapter. Generate the lookup HMAC with the helper
# documented in apps/backend/README.md. The wallet, insurer address, HMAC, and
# permit key must all describe the same configured fictional insurer.
POLICY_REFERENCE_LOOKUP_KEY="CHANGE_ME_RANDOM_POLICY_LOOKUP_KEY"
CLAIMANT_COMMITMENT_KEY="CHANGE_ME_RANDOM_CLAIMANT_COMMITMENT_KEY"
POLICY_ELIGIBILITY_RECORDS_JSON='[{"policyId":"northstar-synthetic-42","policyReferenceHmac":"CHANGE_ME_64_HEX_POLICY_REFERENCE_HMAC","insurerId":"northstar-mutual","insurerAddress":"CHANGE_ME_40_HEX_INSURER_ADDRESS","claimantAddress":"CHANGE_ME_40_HEX_CLAIMANT_ADDRESS","authorizedSubmitterAddresses":["CHANGE_ME_40_HEX_CLAIMANT_ADDRESS"],"coverageStart":"2020-01-01","coverageEnd":"2030-12-31","allowedClaimTypes":["collision","theft","fire","flood"],"maxClaimAmountUsd":100000,"dailyQuota":25}]'

# The JSON contains container paths only. Put owner-only key files in the host
# directory below; Compose mounts the directory read-only into the API.
CLAIM_PERMIT_ISSUER_KEYS_HOST_DIR="./.env.gcp-secrets/permit-issuers"
CLAIM_PERMIT_ISSUERS_JSON='[{"insurerId":"northstar-mutual","privateKeyFile":"/run/secrets/permit-issuers/northstar-mutual.key"}]'

# Shared claim authorization and sponsorship controls.
CLAIM_AUTHORIZATION_KEY="CHANGE_ME_RANDOM_CLAIM_AUTHORIZATION_KEY"
GASLESS_REQUEST_FINGERPRINT_KEY="CHANGE_ME_RANDOM_GASLESS_FINGERPRINT_KEY"
GASLESS_FORWARD_GAS="400000"
GASLESS_SIGNATURE_TTL_SECONDS="600"
GASLESS_MAX_TRANSACTION_GAS="600000"
GASLESS_MAX_FEE_GWEI="100"
GASLESS_MAX_PRIORITY_FEE_GWEI="3"
GASLESS_RELAY_POLL_SECONDS="2"
GASLESS_STUCK_TRANSACTION_SECONDS="120"

# Authenticated private operations and human-review surfaces. Store only SHA-256
# digests here; give each raw key only to the matching operator or assessor.
INDEXER_OPERATIONS_API_KEY_SHA256="CHANGE_ME_64_HEX_SHA256"
INDEXER_STALE_AFTER_SECONDS="120"
ASSESSOR_OUTCOME_CREDENTIALS_JSON='[{"assessorReference":"research-assessor-1","apiKeySha256":"CHANGE_ME_64_HEX_SHA256"}]'

# PostgreSQL stays inside Docker. Use URL-safe hexadecimal so this value can be
# embedded in DATABASE_URL without percent-encoding surprises.
POSTGRES_PASSWORD="CHANGE_ME_RANDOM_HEX_PASSWORD"

# Sepolia identities. The deployment/admin key must never be copied to the VM.
# Runtime signing keys are mounted as owner-only files, not process variables.
SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"
SEPOLIA_RELAYER_PRIVATE_KEY_HOST_FILE="./.env.gcp-secrets/relayer.key"
SEPOLIA_ASSESSOR_PRIVATE_KEY_HOST_FILE="./.env.gcp-secrets/assessor.key"
CLAIMS_DEPLOYMENT_ID="sepolia-public-intake-v1"
RECEIPT_TIMEOUT="180"

# Pinata is used only by server-side containers and must never use a VITE_ name.
PINATA_JWT="CHANGE_ME_PINATA_JWT"
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# Private HMAC used for cross-insurer duplicate screening.
DUPLICATE_FINGERPRINT_KEY="CHANGE_ME_RANDOM_HEX_HMAC_KEY"

# Kafka is private to this VM's Docker network. Topic and consumer-group suffixes
# must exactly match CLAIMS_DEPLOYMENT_ID.
KAFKA_ENABLED="true"
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_CLAIM_SUBMITTED_TOPIC="claims.submitted.sepolia-public-intake-v1"
KAFKA_CLIENT_ID="claims-registry-cloud"
KAFKA_CONSUMER_GROUP_ID="claims-registry-scorer-sepolia-public-intake-v1"
KAFKA_DELIVERY_TIMEOUT_MS="30000"
KAFKA_CONSUMER_POLL_SECONDS="1"
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"
KAFKA_SASL_MECHANISM=""
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# Train and review the model artifact before deployment. The worker receives a
# read-only mount at /opt/claims-model.
XGBOOST_MODEL_HOST_DIR="../../packages/model/artifacts/xgboost-african-motor-v1"
XGBOOST_MODEL_DIR="/opt/claims-model"
XGBOOST_MODEL_SHA256=""

LISTENER_STATE_DIR="/var/lib/claims-listener"
SCORING_STATE_DIR="/var/lib/claims-scoring"
POLL_INTERVAL="5"
CONFIRMATION_BLOCKS="12"
MAX_BLOCK_RANGE="250"
LISTENER_START_BLOCK="11516697"
