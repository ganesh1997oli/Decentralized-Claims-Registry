# Copy to .env.local. The listener itself reads events and does not sign.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Needed only by submit_and_assess_demo.py.
SEPOLIA_PRIVATE_KEY=""

MODULE_ID="ClaimsRegistryModule#ClaimsRegistry"
POLL_INTERVAL="5"
CONFIRMATION_BLOCKS="2"

# Leave empty for the normal deployment-aware starting point.
LISTENER_START_BLOCK=""
